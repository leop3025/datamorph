# Copy to .env.local (never commit it) and add the same variables in Vercel → Settings → Environment Variables.

# AI assistant: one free key is enough. Groq is tried first, then Gemini.
GROQ_API_KEY=
GEMINI_API_KEY=
# Optional model overrides
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash

# Optional: AI requests per visitor per hour (default 30)
# AI_RATE_LIMIT_PER_HOUR=30

# Optional: global rate limit across serverless instances (Upstash Redis free tier)
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
